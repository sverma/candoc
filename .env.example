# Copy to .env on the deployment host; chmod 600 .env
APP_URL=https://candoc.org
POSTGRES_PASSWORD=replace-with-a-long-random-value
COOKIE_SECURE=true
# Optional. Only used after the candidate explicitly opts into external AI.
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna
GITHUB_TOKEN=
# Recovery emails require an authorized sender and mail-service credential.
# SSL uses port 465; STARTTLS uses port 587.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
